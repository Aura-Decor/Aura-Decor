# Ignore unnecessary files for Docker build optimization

# Build artifacts
**/bin/
**/obj/
**/out/

# Test results
TestResults/
**/*.trx
**/*.coverage
**/*.coveragexml

# NuGet packages
**/packages/
*.nupkg
*.snupkg

# Visual Studio files
.vs/
*.user
*.suo
*.sln.docstates
*.userprefs

# Temporary files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Git files
.git/
.gitignore
.gitattributes

# IDE files
*.code-workspace
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json

# Docker files (except the one we're using)
**/Dockerfile*
**/docker-compose*
**/.dockerignore

# Documentation
README.md
**/*.md
docs/

# Logs
logs/
*.log

# Runtime files
**/appsettings.Development.json
**/appsettings.Local.json

# Uploads and user data
**/Uploads/
**/wwwroot/uploads/

# Node modules (if any)
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Dependency directories
**/bower_components/